<urn:sha256:97a4d4bc3bd80543110602d355d0354197bf7745514f2f2e6daaf7a20a040987> <urn:ledger:ns#statement> "Freshness is a position, never an age, and standing queries may not use NOW()" <urn:varve-spike:g/ledger> .
<urn:sha256:97bce203efe22d9ac08f1a27a2a44d5fff55175980afbcc9247a4ca09cc11976> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:ledger:ns#DecisionVersion> <urn:varve-spike:g/ledger> .
<urn:sha256:97bce203efe22d9ac08f1a27a2a44d5fff55175980afbcc9247a4ca09cc11976> <urn:ledger:ns#basedOn> "adr:0123" <urn:varve-spike:g/ledger> .
<urn:sha256:97bce203efe22d9ac08f1a27a2a44d5fff55175980afbcc9247a4ca09cc11976> <urn:ledger:ns#ofDecision> <urn:dec:varve/NumbersAreXsdCanonical> <urn:varve-spike:g/ledger> .
