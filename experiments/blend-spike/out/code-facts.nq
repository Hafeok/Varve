<urn:sha256:108dddfcebd855498fc25156f1deab679cc4f5b347c168ac8c4d1a829ee7ac05> <urn:ledger:ns#ofDecision> <urn:dec:varve/UnreadableGraphIsAbsentNotAnError> <urn:varve-spike:g/ledger> .
