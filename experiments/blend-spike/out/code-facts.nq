<urn:sha256:587f55d8b34f0e5afc374329b2f797244a98e69dda9936dbd779c0e91e6c4337> <urn:ledger:ns#ofDecision> <urn:dec:varve/IndexedDbIsTheFallback> <urn:varve-spike:g/ledger> .
