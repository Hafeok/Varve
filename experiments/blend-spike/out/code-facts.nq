<urn:sha256:32cd980e3486a00c9716d9ba48cab231426e284a905a5c45855728501ac9a4c3> <urn:ledger:ns#ofDecision> <urn:dec:varve/CacheHeadersByReadKind> <urn:varve-spike:g/ledger> .
