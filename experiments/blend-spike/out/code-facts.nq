<urn:sha256:b3adc2dce41d2d625429a01442fc7e1009f6c55bd04aa8285da4c02267651245> <urn:ledger:ns#ofDecision> <urn:dec:varve/SlotBoundAssociatedData> <urn:varve-spike:g/ledger> .
