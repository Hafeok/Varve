<urn:sha256:2aa16716c70dddf9177c3009600449891cb9489b8ecdc561eb6e1d60912a1ee2> <urn:ledger:ns#ofDecision> <urn:dec:varve/DeltaFormatIsInTheBasis> <urn:varve-spike:g/ledger> .
