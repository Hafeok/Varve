<urn:sha256:c1407510066d046a3cccaeb2fb1ef12f5a9fcfda38cd588679f4eefcfadfec07> <urn:ledger:ns#ofDecision> <urn:dec:varve/SubscriptionConsumerOwnsPosition> <urn:varve-spike:g/ledger> .
