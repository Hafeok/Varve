<urn:sha256:0ee7fdaf585b56a634f6f8def676f22c7b84d857e74ad3325dfc927a673ac3ab> <urn:ledger:ns#ofDecision> <urn:dec:varve/CatalogueGraphsGovernedBySource> <urn:varve-spike:g/ledger> .
