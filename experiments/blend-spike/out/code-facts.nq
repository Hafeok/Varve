<urn:sha256:10429ac1e776eaf68806b161442f5b2d25269ab7217c08516a4bdd7fb2ad352a> <urn:ledger:ns#ofDecision> <urn:dec:varve/TripleTermComponentsByHandle> <urn:varve-spike:g/ledger> .
