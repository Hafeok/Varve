<urn:sha256:c13497241588b52b89469952a6b0fd7361ccb2a4684593f43ce2ce08ec898bdc> <urn:ledger:ns#ofDecision> <urn:dec:varve/CredentialFileSupersedesPlatformStore> <urn:varve-spike:g/ledger> .
