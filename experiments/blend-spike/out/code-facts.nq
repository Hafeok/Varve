<urn:sha256:0d8e8ec49a36f19c4e27fcd976164c8c1e911bfea1ef123cbad3cf7415a33ae1> <urn:ledger:ns#ofDecision> <urn:dec:varve/TornBatchWithinTheWriteWindow> <urn:varve-spike:g/ledger> .
