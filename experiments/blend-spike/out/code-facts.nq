<urn:sha256:b2ad22e4aeadf954cc7b44930db42ffbf745c5b51e3ba44ee70fdb2569874d2d> <urn:ledger:ns#ofDecision> <urn:dec:varve/NoApiKeysEver> <urn:varve-spike:g/ledger> .
