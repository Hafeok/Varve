<urn:sha256:b44e462dfe0546f0edb4dc35e59aba5ca95a8aeefc014b93325699935b2ad399> <urn:ledger:ns#ofDecision> <urn:dec:varve/IndexBuiltAgainstTheLog> <urn:varve-spike:g/ledger> .
