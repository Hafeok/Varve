<urn:sha256:29e9519c86247fcc6919d73fcd1276eb43336ec6b228d6d54487e2e46d8fdd32> <urn:ledger:ns#ofDecision> <urn:dec:varve/OperatorStateIsMadeOncePerExecution> <urn:varve-spike:g/ledger> .
