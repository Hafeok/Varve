<urn:sha256:578d93a4ea20f3eb9916c33cd8fb180fcb15dac84d638d962f70cfe85d0696bc> <urn:ledger:ns#ofDecision> <urn:dec:varve/LookupsReadThroughTheBlob> <urn:varve-spike:g/ledger> .
