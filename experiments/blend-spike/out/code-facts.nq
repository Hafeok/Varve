<urn:sha256:b60fb252d9310e6c68f3413a0993a74fcceaf674fac5a2bac299b8c2b8a12e8e> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <urn:ledger:ns#DecisionVersion> <urn:varve-spike:g/ledger> .
