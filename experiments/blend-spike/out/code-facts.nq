<urn:sha256:b40a62bbe02c476bf096b0da4fca64cbe19a19428b577ab2869f0bc40d96eddd> <urn:ledger:ns#ofDecision> <urn:dec:varve/AsOfReadsStructurallyStable> <urn:varve-spike:g/ledger> .
