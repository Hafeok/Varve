<urn:sha256:10957a42b94b533f0dd72ef70882f08364431750b53dea26e609f38cce0ce4a9> <urn:ledger:ns#ofDecision> <urn:dec:varve/TheProcessorIsKeptPerThread> <urn:varve-spike:g/ledger> .
