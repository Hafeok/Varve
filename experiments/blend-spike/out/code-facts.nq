<urn:sha256:105ddecace9acca7701988985e1b9ee4402737e67930d9fd3b595148acbbf3a5> <urn:ledger:ns#ofDecision> <urn:dec:varve/NoHeapHardLimitOfOurOwn> <urn:varve-spike:g/ledger> .
