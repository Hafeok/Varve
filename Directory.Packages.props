<Project>

  <!--
    Central package management. Project files carry no Version attribute; a
    version is changed here and applies everywhere, and a project cannot
    quietly pin a different one.

    Every package below is justified in ADR 0006, which also records the
    version each was resolved at and why the BCL does not suffice. Versions are
    resolved from nuget.org when a package is added, never taken from memory.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Analyzer authoring — build-time only, never shipped">
    <!-- 5.0.0 is a FLOOR, not the latest. It is the Roslyn line shipped with
         the first .NET 10 SDK, 10.0.100. An analyzer requires a host at or
         above the Roslyn it was built against, and an IDE's compiler comes
         from the IDE rather than from global.json — so building against the
         latest makes the analyzer silently fail to load (CS9057) for anyone on
         an older Visual Studio. Raise this only with a reason. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />

    <!-- Not part of the floor: these rules run in *our* build, never in a
         consumer's host, so latest is correct for them. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup Label="Off-the-shelf enforcement — build-time only, never shipped">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Test-time">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <!-- Follows the analyzer's floor: the harness compiles against the same
         Roslyn the analyzer does, so a test cannot pass against an API the
         shipped analyzer would not have. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Label="Test-time, temporary — remove at milestone 5">
    <!-- Reads the W3C manifests, which are Turtle, because we have no Turtle
         parser yet. Confined to one internal class in Varve.Conformance.Tests.
         Exit criterion in ADR 0007: removed when Varve.Turtle passes
         rdf/rdf11/rdf-turtle unexempted. If this line is still here after
         milestone 5, that is a defect. -->
    <PackageVersion Include="dotNetRdf.Core" Version="3.5.2" />

    <!-- A transitive dependency of dotNetRdf.Core, pinned rather than
         inherited. dotNetRdf.Core asks for AngleSharp 1.4.0, which NuGet audit
         flags as GHSA-pgww-w46g-26qg, and warnings are errors here. Central
         transitive pinning raises it to a version without the advisory. We
         never call into it — dotNetRdf uses it for HTML and RDFa, and this
         repository reads Turtle manifests — but a known-vulnerable package in
         the graph is not something to silence with NoWarn. It leaves with
         dotNetRdf.Core at milestone 5. -->
    <PackageVersion Include="AngleSharp" Version="1.8.2" />
  </ItemGroup>

</Project>
