<Project>

  <!--
    Central package management. Project files carry no Version attribute; a
    version is changed here and applies everywhere, and a project cannot
    quietly pin a different one.

    THIS FILE IS THE REGISTER. ADR 0009 states the policy; this file is the
    list, and eng/dependency-register.cs makes it a gate.

    Every PackageVersion carries Adr="NNNN" naming the decision that admits it,
    transitive pins included. A package admitted by the policy alone cites 0009;
    one admitted by a specific decision cites that decision instead, because a
    citation pointing at the reasoning is worth more than one pointing at the
    policy. The gate fails the build when the metadata is missing or cites an
    ADR that does not exist.

    Versions are resolved from nuget.org when a package is added, never taken
    from memory. Latest stable is the default; the Roslyn floor below is the one
    named exception, and ADR 0009 says why.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Analyzer authoring — build-time only, never shipped">
    <!-- 5.0.0 is a FLOOR, not the latest. It is the Roslyn line shipped with
         the first .NET 10 SDK, 10.0.100. An analyzer requires a host at or
         above the Roslyn it was built against, and an IDE's compiler comes
         from the IDE rather than from global.json — so building against the
         latest makes the analyzer silently fail to load (CS9057) for anyone on
         an older Visual Studio. Raise this only with a reason. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" Adr="0009" />

    <!-- Not part of the floor: these rules run in *our* build, never in a
         consumer's host, so latest is correct for them. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" Adr="0009" />
  </ItemGroup>

  <ItemGroup Label="Decision-driven enforcement — build-time only, never shipped">
    <!-- The DD rules, the generator that turns docs/decisions/ into types, and
         the attributes code cites decisions with. Prerelease: the latest
         preview is taken, and a bump carries the changelog's breaking entries
         in its commit body (ADR 0063). Referenced from Directory.Build.props
         with PrivateAssets="all", so it is never in a published package's
         dependencies. -->
    <PackageVersion Include="DecisionDriven.Analyzers" Version="0.1.0-preview.9" Adr="0063" />

    <!-- The whole-graph report, a .NET tool run in CI and never a gate. No
         project references it: .config/dotnet-tools.json installs it, at the
         same version, which a bump changes in both places. Registered here
         because this file is the register of every dependency (ADR 0009). -->
    <PackageVersion Include="DecisionDriven.Report" Version="0.1.0-preview.7" Adr="0063" />
  </ItemGroup>

  <ItemGroup Label="Off-the-shelf enforcement — build-time only, never shipped">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" Adr="0004" />
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" Adr="0004" />
  </ItemGroup>

  <ItemGroup Label="repo-standard — runtime of the tool under tools/repo-standard, never of Varve">
    <!-- The YAML reader and writer of repo-standard's declarations. MIT, no
         dependencies of its own. Only its parser and emitter are used, never
         its reflection-based serializer, which is what keeps the tool's Native
         AOT build clean. ADR 0039. -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" Adr="0039" Scope="tools/repo-standard/" />
  </ItemGroup>

  <ItemGroup Label="Runtime of Varve.Server only — never of a library">
    <!-- OIDC bearer-token validation (ADR 0037). Not in the ASP.NET Core
         shared framework, whatever ADR 0037's consequences said: a NuGet
         package since 3.0, admitted by ADR 0099 in Varve.Server alone, on the
         condition that the server's Native AOT publish stays green. Its
         Microsoft.IdentityModel.Protocols.OpenIdConnect closure (Protocols,
         Tokens, JsonWebTokens, Logging, Abstractions) comes with it, MIT and
         managed; the register cites the decision for the direct package and
         the gate counts the closure in Varve.Server's assets. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" Adr="0099" Scope="src/Varve.Server/" />

    <!-- The CLI's command line (ADR 0105): stable, MIT, Microsoft, no native
         asset, trimming- and AOT-annotated; in Varve.Server alone, on the
         same condition as JwtBearer, that the server's Native AOT publish
         stays green. -->
    <PackageVersion Include="System.CommandLine" Version="2.0.14" Adr="0105" Scope="src/Varve.Server/" />

    <!-- The CLI's credential file on Windows (ADR 0105): DPAPI through the
         managed wrapper, CurrentUser scope. Elsewhere the file's mode is the
         protection, and the package is linked but never called. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" Adr="0105" Scope="src/Varve.Server/" />

    <!-- The OpenTelemetry exporter (ADR 0112): the SDK, its hosting
         integration and the OTLP exporter, Apache-2.0, managed, trimming- and
         AOT-annotated; in Varve.Server alone, on the condition that the
         server's Native AOT publish stays green. The libraries instrument
         through the BCL's ActivitySource and Meter and reference none of
         these; the server builds the SDK only when an OTEL_EXPORTER_OTLP_*
         endpoint is configured. -->
    <PackageVersion Include="OpenTelemetry" Version="1.20.1" Adr="0112" Scope="src/Varve.Server/" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" Adr="0112" Scope="src/Varve.Server/" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" Adr="0112" Scope="src/Varve.Server/" />
  </ItemGroup>

  <ItemGroup Label="Varve.Protocol.Client's hosting (ADR 0131)">
    <!-- AddVarve on IServiceCollection and the hosted service that applies a
         dataset's setup at start: the two abstractions packages every .NET
         host already loads, MIT, managed, trimming- and AOT-annotated, no
         native asset. At the runtime's version, as JwtBearer is. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" Adr="0131" Scope="src/Varve.Protocol.Client/" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" Adr="0131" Scope="src/Varve.Protocol.Client/" />
  </ItemGroup>

  <ItemGroup Label="Samples only — never of a shipped package (ADR 0133)">
    <!-- What an application really uses, for the samples that show how one
         uses Varve. Scoped to samples/, and the register fails a reference
         from anywhere else. Microsoft Identity Web, MIT: the on-behalf-of
         sample's token validation and its exchange through MSAL (ADR 0127);
         its MSAL and Microsoft.IdentityModel closure comes with it, into the
         sample alone. Varve's server is a consumer of tokens and never an
         acquirer (ADR 0037). -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.16.0" Adr="0133" Scope="samples/" />
  </ItemGroup>

  <ItemGroup Label="Events: the Event Hubs sample and the schema validator of the tests (ADR 0146)">
    <!-- Azure.Messaging.EventHubs, MIT, managed (lib/net8.0 and
         netstandard2.0, no runtimes/): the Event Hubs bridge sample publishes
         rendered CloudEvents with it (ADR 0143); its Azure.Core, Azure.Core.Amqp
         and Microsoft.Azure.Amqp closure, MIT and managed, comes with it into
         the sample alone. An Event Hubs package in src/ is a non-goal until a
         second consumer wants one.
         JsonSchema.Net, MIT: the events tests validate every rendered event
         against its generated schema (2020-12) and every AsyncAPI document
         against the AsyncAPI 3.0 schema (draft-07). Pinned at 8.0.5, the last
         release whose package licence is the MIT expression alone: from 9.0.0
         the binaries carry the json-everything Open Source Maintenance Fee
         agreement, so Dependabot's 9.x proposals are declined with ADR 0146.
         Its lib/ holds net8.0, net9.0, net10.0 and netstandard2.0 and no
         runtimes/ folder: no native asset. Its closure, JsonPointer.Net 6.0.0,
         Json.More.Net 2.2.0 and Humanizer.Core 3.0.1, is MIT and managed. -->
    <PackageVersion Include="Azure.Messaging.EventHubs" Version="5.12.2" Adr="0146" Scope="samples/" />
    <PackageVersion Include="JsonSchema.Net" Version="8.0.5" Adr="0146" Scope="tests/" />
  </ItemGroup>

  <ItemGroup Label="Varve.Aspire and its sample (ADR 0117)">
    <!-- The hosting integration's one reference: Aspire's hosting model, MIT,
         managed, which it extends with AddVarve; it references nothing from
         Varve. The sample AppHost and its test under samples/ take the SDK,
         the AppHost package and the testing package at the same version;
         they are outside the packable set and never shipped (ADR 0009 as
         amended), so the platform binaries the orchestration and the
         dashboard carry are never in an artefact of ours. -->
    <PackageVersion Include="Aspire.Hosting" Version="13.6.1" Adr="0117" Scope="src/Varve.Aspire/, samples/" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.1" Adr="0117" Scope="samples/" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.1" Adr="0117" Scope="samples/" />
    <!-- Pinned past Aspire.Hosting 13.6.1's own dependency (2.5.302), which
         NuGet's audit flags: GHSA-qhrr-8q5h-9q3h (moderate; nested arrays
         allocate past the depth limit when deserialising into object),
         patched in 2.5.303. Transitive pinning lifts it in the closure of
         Varve.Aspire and the Aspire sample alone; ADR 0117's amendment of
         2026-10-16 admits it, and it leaves when Aspire.Hosting's own
         dependency moves past the advisory. -->
    <PackageVersion Include="MessagePack" Version="2.5.303" Adr="0117" Scope="src/Varve.Aspire/, samples/" />
  </ItemGroup>

  <!--
    Container images of the auth and storage test legs (ADRs 0099, 0100, 0134). Not packages, so
    not PackageVersion items and not counted by the gate; listed here because
    this file is the register of every dependency. Started by the workflow and
    the devcontainer, never by a test. The digests live in
    .github/ci-images.yaml, the source of truth, and CI pulls each image from
    this repository's private mirror, ghcr.io/hafeok/varve-ci, at that digest
    (#118, ADR 0099's amendment of 2026-10-19), except the Event Hubs
    emulator, which it keeps upstream. The table names the upstream image; a
    bump changes the line here in the same commit.

    | Image | Tag | Licence | Pinned in |
    |=======|=====|=========|===========|
    | ghcr.io/navikt/mock-oauth2-server | 6.0.4 | MIT | .github/mock-oauth2/compose.yaml; samples/Varve.Aspire.Sample/Program.cs |
    | ghcr.io/zitadel/zitadel | v4.19.4 | AGPL-3.0 (run, never linked or shipped) | .github/zitadel/compose.yaml |
    | public.ecr.aws/docker/library/postgres | 18.6-alpine | PostgreSQL | .github/zitadel/compose.yaml |
    | mcr.microsoft.com/azure-storage/azurite | 3.37.0 | MIT | .github/storage/compose.yaml (ADR 0134) |
    | ghcr.io/rustfs/rustfs | 1.0.1 | Apache-2.0 | .github/storage/compose.yaml (ADR 0134) |
    | mcr.microsoft.com/azure-messaging/eventhubs-emulator | 2.2.1 | Microsoft's emulator licence, accepted by ACCEPT_EULA=Y (run in CI, never linked or shipped; ADR 0146) | .github/eventhubs/compose.yaml |
    | mcr.microsoft.com/azure-storage/azurite | 3.37.0 | MIT (ADR 0146) | .github/eventhubs/compose.yaml |
  -->

  <ItemGroup Label="Test-time">
    <PackageVersion Include="xunit.v3" Version="4.0.2" Adr="0009" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" Adr="0007" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" Adr="0004" />
    <!-- A transitive dependency of the analyzer harness, pinned rather than
         inherited: Microsoft.CodeAnalysis.Analyzer.Testing asks for
         NuGet.Packaging 7.0.3, which asks for System.Security.Cryptography.Pkcs
         9.0.6, and NuGet audit flags every version through 9.0.20 and 10.0.12
         (GHSA-846f-f764-76mx, high; GHSA-2fmv-rv2c-59x7, moderate; both in
         the audit data from 2026-10-14). Warnings are errors here. Central
         transitive pinning raises it to the latest stable, outside both
         ranges. The harness reaches it through NuGet.Packaging, which it uses
         to fetch reference assemblies; the pin leaves when the harness's own
         dependency moves past the advisories. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" Adr="0004" />
    <!-- Follows the analyzer's floor: the harness compiles against the same
         Roslyn the analyzer does, so a test cannot pass against an API the
         shipped analyzer would not have. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" Adr="0009" />

    <!-- Property-based testing. Apache-2.0, and zero dependencies of its own,
         which is what decided it against FsCheck's FSharp.Core. ADR 0025. -->
    <PackageVersion Include="CsCheck" Version="4.9.1" Adr="0025" />

    <!-- Versioning from the git tag. Apache-2.0, no dependencies of its own,
         and it contributes nothing to the package it versions: PrivateAssets
         keeps it out of the consumer's graph. ADR 0029. -->
    <PackageVersion Include="MinVer" Version="8.0.0" Adr="0029" />

    <!-- Benchmarks. Benchmark-time only, never referenced by anything
         shippable, and out of CI. Its Gee.External.Capstone dependency brings
         nine native .so files, which ADR 0009's native-asset ban covers by its
         dated amendment: the ban is on shipped artifacts, not on a benchmark
         harness. ADR 0027. -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" Adr="0027" />
  </ItemGroup>

  <ItemGroup Label="Test-time, temporary — remove at milestone 5">
    <!-- Reads the W3C manifests, which are Turtle, because we have no Turtle
         parser yet. Confined to one internal class in Varve.Conformance.Tests.
         Exit criterion in ADR 0007: removed when Varve.Turtle passes
         rdf/rdf11/rdf-turtle unexempted. If this line is still here after
         milestone 5, that is a defect. -->
    <!-- ADR 0007's exit criterion is MET, at milestone 3b: the conformance
         harness reads its manifests with Varve.Turtle and no longer references
         this package. What remains is ADR 0027's separate justification — the
         benchmark baseline, because a performance claim needs something to
         compare against — so the line stays for tests/Varve.Benchmarks alone.
         The harness's freedom from it is a test, not a convention:
         The_harness_does_not_reference_another_rdf_implementation. -->
    <PackageVersion Include="dotNetRdf.Core" Version="3.5.2" Adr="0027" />

    <!-- dotNetRDF's SHACL validator, MIT, on dotNetRdf.Core 3.5.2 and no
         native asset: the SHACL benchmark's baseline and a differential oracle
         in Varve.Shacl.Sparql.Tests, never src/ (ADR 0156). A disagreement is
         judged against the specification, never settled by matching it. -->
    <PackageVersion Include="dotNetRdf.Shacl" Version="3.5.2" Adr="0156" Scope="tests/" />

    <!-- A transitive dependency of dotNetRdf.Core, pinned rather than
         inherited. dotNetRdf.Core asks for AngleSharp 1.4.0, which NuGet audit
         flags as GHSA-pgww-w46g-26qg, and warnings are errors here. Central
         transitive pinning raises it to a version without the advisory. We
         never call into it — dotNetRdf uses it for HTML and RDFa, and this
         repository reads Turtle manifests — but a known-vulnerable package in
         the graph is not something to silence with NoWarn. It is now in the
         benchmark project's graph only, the conformance harness having dropped
         dotNetRdf.Core at milestone 3b, and it leaves when that does. -->
    <PackageVersion Include="AngleSharp" Version="1.8.2" Adr="0063" />
  </ItemGroup>

</Project>
