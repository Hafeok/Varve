<Project>

  <!--
    Repository-wide build settings. Imported before every project body, so a
    project may override anything here by setting it again (Varve.Analyzers
    overrides TargetFramework; see ADR 0008).

    ADR 0008 — target framework and language version policy.
    ADR 0003, ADR 0064 — package layering; ArchLayer is declared per project.
    ADR 0004 — enforcement by analyzers.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- Usings are explicit. A file's dependencies are visible in the file,
         which matters in a repository whose central rule is about what a
         compilation may reference. ADR 0008. -->
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <!-- A warning nobody is forced to read is a warning nobody reads. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Required for IDE0005 to work at build time, and required of any
         package we eventually publish. ADR 0008. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Two builds of one commit produce the same bytes. This is a
         precondition for trusting what the conformance run reports. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' != ''">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Nothing is packable at milestone 1, by design: the brief forbids
         scaffolding that compiles and does nothing. A package project opts in
         explicitly, which switches on the checks in Directory.Build.targets. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    DecisionDriven.Analyzers (ADR 0062, ADR 0063): the DD rules, and the
    generator that turns docs/decisions/ into the types code cites. Every
    project in the family is analyzed by it, build-time only: PrivateAssets
    keeps it out of every published package's dependencies, and IncludeAssets
    takes its analyzers and its build/ props and targets and nothing else.
  -->
  <ItemGroup>
    <PackageReference Include="DecisionDriven.Analyzers" PrivateAssets="all" IncludeAssets="analyzers;build" />
  </ItemGroup>

  <!--
    Varve's configuration of the DD rules (ADR 0064).

    ArchFamily is the family every Varve.* assembly is in. ArchLayer is per
    project, in each project file: the layer ADR 0060's table gives it, and
    unset for a test assembly and Varve.Analyzers. The package generates
    [assembly: ArchLayer(n)] from it, which is how a referencing compilation
    reads the layer back (DD0001). ArchCompositionRoot is true on exactly the
    layer-6 projects, set in each one, and VARVE0005 holds the two together.

    ArchContractTypeAssemblies is the vocabulary a contract may name beyond the
    BCL and its own assembly's model. The global value is layers 0 and 1. It is
    never widened here: Varve.Store's contracts are SPARQL-free (ADR 0005), and
    a global Varve.Sparql would let an algebra type onto one with no
    diagnostic. A project that needs more appends it in its own file, with its
    reason (Varve.Sparql.Evaluation does).

    The ledger is docs/decisions/, one set file per ADR (ADR 0062). The package
    targets glob it into AdditionalFiles with DdLedger="decision-set".
  -->
  <PropertyGroup>
    <ArchFamily>Varve</ArchFamily>
    <ArchContractTypeAssemblies>Varve.Rdf;Varve.Iri;Varve.Xsd</ArchContractTypeAssemblies>
    <DdLedgerDirectory>$(MSBuildThisFileDirectory)docs/decisions</DdLedgerDirectory>
  </PropertyGroup>

  <!--
    VARVE0005 (ADR 0064) reads these, beside the four Arch* properties the
    package already makes visible: whether an assembly is published is the
    question the layer declaration turns on, and an executable is what ADR 0060
    reserves to layer 6.
  -->
  <ItemGroup>
    <CompilerVisibleProperty Include="IsPackable" />
    <CompilerVisibleProperty Include="OutputType" />
  </ItemGroup>

  <!--
    Every project is analyzed by Varve.Analyzers, as an analyzer and never as a
    library, so it is never a runtime dependency (ADR 0004).

    Two exclusions. The analyzer cannot analyze itself into a cycle, and its
    test project references it as an ordinary library in order to instantiate
    the rule types.

    The fixtures under tests/fixtures/ inherit this file, and that is precisely
    how the end-to-end test gets a real MSBuild-wired analyzer to fail against.
  -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Varve.Analyzers' and '$(MSBuildProjectName)' != 'Varve.Analyzers.Tests'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Varve.Analyzers/Varve.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
