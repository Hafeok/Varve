#!/usr/bin/env bash
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# Two things, made when the commit is made, for every author and every tool.
#
# First, a model's name (ADR 0241, #169). eng/model-names.cs holds the pattern
# the gate uses too: a Co-Authored-By: trailer that names a model is rewritten
# to `Co-Authored-By: Claude <noreply@anthropic.com>`, and a name anywhere else
# refuses the commit, with the line named. When the script cannot run (no SDK),
# the hook says so and leaves the message to the gate in CI.
#
# Second, the DCO sign-off as eng/dco.cs reads it (ADR 0034 point 3, ADR
# 0087). An agent's commit is signed off by its responsible human in
# eng/identities.json, never by the agent: `git commit -s`
# in a session signs off as the session's own identity, which the gate refuses.
# So the hook drops an agent's own sign-off and adds the one the gate accepts.
# A human's commit is left as written.
#
# Activated by `git config core.hooksPath eng/hooks` (AGENTS.md; the
# devcontainer's post-create.sh sets it).

set -euo pipefail

message="$1"
root="$(git rev-parse --show-toplevel)"
author="$(git var GIT_AUTHOR_IDENT | sed -E 's/^.*<([^>]*)>.*$/\1/')"

status=0
dotnet run "$root/eng/model-names.cs" -- --message "$message" || status=$?
case "$status" in
    0) ;;
    1) exit 1 ;;
    *) echo "commit-msg: eng/model-names.cs could not run (exit $status); the model-names gate checks this commit in CI" >&2 ;;
esac

# eng/dco.cs names the sign-off the gate accepts from this author. For a human
# it is their own, and their message is left as they wrote it; an author in no
# entry is refused by the gate in CI, with its own hint.
trailer="$(dotnet run "$root/eng/dco.cs" -- --sign-off-for "$author" 2>/dev/null)" || exit 0
case "$trailer" in
    *"<$author>") exit 0 ;;
    "Signed-off-by: "*) ;;
    *) echo "commit-msg: eng/dco.cs named no sign-off for $author" >&2; exit 1 ;;
esac

# An agent's own sign-off goes; its responsible human's is added once.
grep -viF "Signed-off-by: " "$message" > "$message.dco" || true
grep -iF "Signed-off-by: " "$message" | grep -viF "<$author>" >> "$message.dco" || true
mv "$message.dco" "$message"
git interpret-trailers --in-place --if-exists addIfDifferent --trailer "$trailer" "$message"
