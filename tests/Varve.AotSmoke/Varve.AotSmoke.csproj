<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Layer 6, not 'none'. A smoke app is a host: it consumes the stack from
         the top, which is exactly what makes it a smoke test, and an
         executable is a composition root, which ADR 0060 reserves to layer 6.
         Declaring a real layer also means DD0001 checks this reference
         like any other, rather than the app being exempt from the rule it is
         here to exercise. It is not packable, so nothing is published. -->
    <ArchLayer>6</ArchLayer>
    <ArchCompositionRoot>true</ArchCompositionRoot>

    <!-- Constraint 2, proven rather than configured. The trimming and AOT
         analyzers are on for packable projects, but an analyzer only sees
         what it can see statically; only a real ILC run proves the packages
         publish and the binary runs. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>false</StackTraceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- IL2xxx and IL3xxx are errors in .editorconfig; these make the ILC
         run itself fail on a warning too, rather than printing one. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Varve.Turtle/Varve.Turtle.csproj" />
    <ProjectReference Include="../../src/Varve.Store/Varve.Store.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql/Varve.Sparql.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql.Evaluation/Varve.Sparql.Evaluation.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql.Results/Varve.Sparql.Results.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql.Store/Varve.Sparql.Store.csproj" />
  </ItemGroup>

</Project>
