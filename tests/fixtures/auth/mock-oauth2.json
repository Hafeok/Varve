{
  "interactiveLogin": true,
  "httpServer": "NettyWrapper",
  "tokenCallbacks": [
    {
      "issuerId": "varve",
      "tokenExpiry": 300,
      "requestMappings": [
        {
          "requestParam": "scope",
          "match": ".*varve-webui-manage.*",
          "claims": {
            "sub": "${subject}",
            "aud": [ "api://varve-manage" ],
            "roles": [ "varve.operator" ]
          }
        },
        {
          "requestParam": "client_id",
          "match": "varve-webui",
          "claims": {
            "sub": "${subject}",
            "aud": [ "api://varve", "varve-webui" ],
            "roles": [ "varve.read" ]
          }
        },
        {
          "requestParam": "client_id",
          "match": "varve-writer",
          "claims": {
            "sub": "varve-writer",
            "aud": [ "api://varve" ],
            "roles": [ "varve.write" ]
          }
        },
        {
          "requestParam": "scope",
          "match": "api://varve-manage",
          "claims": {
            "sub": "${clientId}",
            "aud": [ "api://varve-manage" ],
            "roles": [ "varve.operator" ]
          }
        },
        {
          "requestParam": "client_id",
          "match": "varve-cli",
          "claims": {
            "sub": "${subject}",
            "aud": [ "api://varve" ],
            "roles": [ "varve.read" ]
          }
        }
      ]
    }
  ]
}
