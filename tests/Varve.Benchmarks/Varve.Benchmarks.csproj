<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Layer 6 (ADR 0060). A benchmark composes the public packages from the
         top, as a host does, and is an executable, which is a composition
         root; it declared 'none' by name until 0060 took that away. -->
    <ArchLayer>6</ArchLayer>
    <ArchCompositionRoot>true</ArchCompositionRoot>

    <!-- BenchmarkDotNet needs release code with the optimiser on to measure
         anything meaningful, and says so loudly if it is not. -->
    <Optimize>true</Optimize>

    <!-- BlockReadBenchmarks reads a memory-mapped view through a pointer, the
         way ADR 0071's other read path would; nothing shipped does. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The linked conformance files below cite types of their own project in
         their doc comments (ManifestReader, SubmoduleGuardTests), which this
         assembly does not compile. -->
    <NoWarn>$(NoWarn);CS1574</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Varve.Turtle/Varve.Turtle.csproj" />
    <ProjectReference Include="../../src/Varve.RdfXml/Varve.RdfXml.csproj" />
    <ProjectReference Include="../../src/Varve.Store/Varve.Store.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql/Varve.Sparql.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql.Results/Varve.Sparql.Results.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql.Evaluation/Varve.Sparql.Evaluation.csproj" />
    <ProjectReference Include="../../src/Varve.Sparql.Store/Varve.Sparql.Store.csproj" />
    <ProjectReference Include="../../src/Varve.Shacl/Varve.Shacl.csproj" />
    <ProjectReference Include="../../src/Varve.Shacl.Sparql/Varve.Shacl.Sparql.csproj" />
    <ProjectReference Include="../../src/Varve.Shacl.Store/Varve.Shacl.Store.csproj" />
    <ProjectReference Include="../../src/Varve.Store.ObjectStorage/Varve.Store.ObjectStorage.csproj" />
    <ProjectReference Include="../../src/Varve.Store.Azure/Varve.Store.Azure.csproj" />
    <ProjectReference Include="../../src/Varve.Store.S3/Varve.Store.S3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The REC portfolio generator (ADR 0141), linked: the object-storage
         benchmarks load its stated sizes. It depends on no test framework. -->
    <Compile Include="../Varve.Rec.Tests/RecPortfolio.cs;../Varve.Rec.Tests/SplitMix64.cs" LinkBase="Rec" />
  </ItemGroup>

  <ItemGroup>
    <!-- The evaluation suite's runner, linked rather than referenced: ADR 0050's
         suite time and the differential run against Oxigraph run the same
         cases through the same loader and comparator as the conformance gate,
         and none of these files depends on the test framework. -->
    <Compile Include="../Varve.Conformance.Tests/EvaluationRunner.cs;../Varve.Conformance.Tests/EvaluationData.cs;../Varve.Conformance.Tests/EvaluationSuite.cs;../Varve.Conformance.Tests/EvaluationSubject.cs;../Varve.Conformance.Tests/ResultTable.cs;../Varve.Conformance.Tests/ManifestGraph.cs;../Varve.Conformance.Tests/TestData.cs;../Varve.Conformance.Tests/Isomorphism.cs;../Varve.Conformance.Tests/ParsedQuad.cs;../Varve.Conformance.Tests/DatasetComparison.cs" LinkBase="Conformance" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />

    <!-- The baseline. ADR 0027: a throughput number with nothing to compare it
         against says only that the machine is a machine. -->
    <PackageReference Include="dotNetRdf.Core" />
    <!-- The SHACL baseline (ADR 0156). -->
    <PackageReference Include="dotNetRdf.Shacl" />
  </ItemGroup>

  <!-- ADR 0110 and 0215: the soak runs under the image's runtime configuration. -->
  <Import Project="../../src/Varve.Server/ShippedRuntime.props" />

</Project>
