<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <WasmMainJSPath>main.js</WasmMainJSPath>

    <!-- [JSImport] and [JSExport] generate interop marshalling that needs it,
         as in Varve.WasmSmoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>false</IsPackable>

    <!-- A host, so layer 6 (ADR 0060), like Varve.WasmSmoke. It runs the
         storage contract and the determinism script in headless Chromium,
         driven by eng/browser-tests.cs (ADR 0084). Nothing is published. -->
    <ArchLayer>6</ArchLayer>
    <ArchCompositionRoot>true</ArchCompositionRoot>

    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Constraint 2: the backend is run trimmed, as a deployment runs it. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Varve.Store/Varve.Store.csproj" />
    <ProjectReference Include="../../src/Varve.Store.Browser/Varve.Store.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The storage contract's cases, the same file xunit runs on the
         desktop backends. -->
    <Compile Include="../Varve.Store.Tests/StorageContractCases.cs" Link="StorageContractCases.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied into the app bundle beside main.js and _framework. -->
    <WasmExtraFilesToDeploy Include="index.html" />
    <WasmExtraFilesToDeploy Include="worker.js" />
    <WasmExtraFilesToDeploy Include="run.js" />
  </ItemGroup>

</Project>
