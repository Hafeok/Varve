<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Layer 4: the log, the projection contract, the pre-commit validator
         contract. SPARQL-free and SHACL-free (ADR 0005). ADR 0003. -->
    <ArchLayer>4</ArchLayer>
    <IsPackable>true</IsPackable>

    <!-- No ambient clock and no ambient randomness: §10 compares log bytes
         across machines. eng/BannedSymbols.Deterministic.txt. ADR 0011. -->
    <VarveDeterministic>true</VarveDeterministic>

    <Description>An event-sourced RDF store: an append-only log of effective deltas, a default quad projection, pinned and as-of reads, checkpoints, subscriptions, and the projection and validator contracts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Rdf/Varve.Rdf.csproj" />

    <!-- Layer 0. The inline rule asks whether a lexical form is canonical for
         its datatype, and Varve.Xsd is the one definition of canonical
         (ADR 0051), so the store asks it rather than keeping a second. -->
    <ProjectReference Include="../Varve.Xsd/Varve.Xsd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Two seams only a test may reach, both recorded in the milestone 4
         report: a fault in the default projection (the failed state), and
         appending an Erasure commit before erasure mode exists. DD0002
         permits InternalsVisibleTo toward *.Tests only (ADR 0062). -->
    <InternalsVisibleTo Include="Varve.Store.Tests" />
  </ItemGroup>

</Project>
