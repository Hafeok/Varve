@* Where a view was read (#167, A6): the dataset position the response
   describes, the management position the instance had applied, and when.
   A position the server did not name is said to be absent, never invented. *@
<p data-read-at>
    Read
    @if (Facts.Position is { } position)
    {
        <text> at position <span data-position>@position</span></text>
    }
    else
    {
        <text> live, at no dataset position</text>
    }
    @if (Facts.ManagementPosition is { } management)
    {
        <text>, management position <span data-management-position>@management</span></text>
    }
    <text>, </text><time datetime="@At.ToString("o", System.Globalization.CultureInfo.InvariantCulture)">@At.ToString("u", System.Globalization.CultureInfo.InvariantCulture)</time>.
    @if (Facts.RequestId is { } request)
    {
        <text> Request </text><code>@request</code><text>.</text>
    }
</p>

@code {
    /// <summary>The response's facts.</summary>
    [Parameter, EditorRequired]
    public ResponseFacts Facts { get; set; }

    /// <summary>When the response was read.</summary>
    [Parameter, EditorRequired]
    public DateTimeOffset At { get; set; }
}
