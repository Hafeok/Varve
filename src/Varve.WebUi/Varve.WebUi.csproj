<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Layer 6: a host and a composition root, never a library (ADRs 0060,
         0200). The Web UI is a client of the public API with no endpoints of
         its own (#96): it reaches the server through Varve.Protocol.Client
         and nothing else. Published as static files, never packed. -->
    <OutputType>Exe</OutputType>
    <ArchLayer>6</ArchLayer>
    <ArchCompositionRoot>true</ArchCompositionRoot>
    <RootNamespace>Varve.WebUi</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- Shipped all the same, as a release asset of static files: the
         native-asset gate walks its closure as it walks a package's
         (ADR 0200, eng/native-assets.cs). -->
    <VarveShipped>true</VarveShipped>

    <!-- Transport addresses are System.Uri, as in the client it composes
         (ADR 0004, amended 2026-10-08). -->
    <VarveSpeaksHttp>true</VarveSpeaksHttp>

    <!-- No inline script, so a CSP of script-src 'self' 'wasm-unsafe-eval'
         holds (ADR 0202): index.html loads one external script, and publish
         writes no import map into it. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>

    <!-- Constraint 2. A trim or AOT warning here is a real finding about the
         browser build, not noise. Blazor's own trim mode, partial: every
         assembly marked trimmable is trimmed, Varve's libraries included,
         and the app's assembly is kept. Full trimming measured the same size
         once the app was kept, and without keeping it removed the components
         the router makes from their Type (ADR 0200). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- The feature switches the browser size measurements used (ADR 0200):
         no ICU, no time zone data, and nothing a page has no use for. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>false</MetricsSupport>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <!-- The runtime relinked to what the app uses, at publish only: it needs
         the wasm-tools workload, which the jobs that publish install and the
         build jobs do not (ADR 0200). -->
    <WasmBuildNative>true</WasmBuildNative>
    <WasmNativeStrip>true</WasmNativeStrip>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Protocol.Client/Varve.Protocol.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0003 permits InternalsVisibleTo toward *.Tests only. -->
    <InternalsVisibleTo Include="Varve.WebUi.Tests" />
  </ItemGroup>

  <!-- The commit this build came from, as a constant: a problem's page is
       linked at it (ProblemDocs). Written from SourceLink's SourceRevisionId,
       because reading it back from an assembly attribute at run time would be
       reflection, which shipped code never uses. -->
  <Target Name="WriteBuildRevision" AfterTargets="InitializeSourceControlInformation" BeforeTargets="CoreCompile;CoreGenerateAssemblyInfo" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_BuildRevisionFile>$(IntermediateOutputPath)BuildRevision.g.cs</_BuildRevisionFile>
      <_BuildRevisionCommit Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevisionId)', '^[0-9a-f]{40}$'))">$(SourceRevisionId)</_BuildRevisionCommit>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildRevisionFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="// Generated by Varve.WebUi.csproj.;namespace Varve.WebUi%3B;internal static class BuildRevision { internal const string Commit = &quot;$(_BuildRevisionCommit)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(_BuildRevisionFile)" />
      <FileWrites Include="$(_BuildRevisionFile)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Blazor WebAssembly (ADR 0200), scoped to this project and its tests in
         the register. No DevServer: the server or a static host serves the
         bundle. No authentication package: sign-in is this host's own
         (ADR 0201). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

</Project>
