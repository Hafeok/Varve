<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Layer 8: a host and a composition root, never a library (ADRs 0060,
         0200), above its two private assemblies, the explorer at 7 and the
         shared components at 6, so every reference among the three points
         strictly downward (ADR 0252). The Web UI is a client of the public
         API with no endpoints of its own (#96): it reaches the server through
         Varve.Protocol.Client and nothing else. Published as static files,
         never packed. -->
    <OutputType>Exe</OutputType>
    <ArchLayer>8</ArchLayer>
    <ArchCompositionRoot>true</ArchCompositionRoot>
    <RootNamespace>Varve.WebUi</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- Shipped all the same, as a release asset of static files: the
         register gate walks its closure as it walks a package's, for
         licences and native assets (ADR 0200, eng/dependency-register.cs),
         and eng/sbom.cs writes the bundle's SBOM from it (ADR 0225). -->
    <VarveShipped>true</VarveShipped>

    <!-- Transport addresses are System.Uri, as in the client it composes
         (ADR 0004, amended 2026-10-08). -->
    <VarveSpeaksHttp>true</VarveSpeaksHttp>

    <!-- No inline script, so a CSP of script-src 'self' 'wasm-unsafe-eval'
         holds (ADR 0202): index.html loads one external script, and publish
         writes no import map into it. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>

    <!-- Constraint 2. A trim or AOT warning here is a real finding about the
         browser build, not noise. Blazor's own trim mode, partial: every
         assembly marked trimmable is trimmed, Varve's libraries included,
         and the app's assembly is kept. Full trimming measured the same size
         once the app was kept, and without keeping it removed the components
         the router makes from their Type (ADR 0200). -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- The feature switches the browser size measurements used (ADR 0200):
         nothing a page has no use for. No ICU and no time zone data are
         below, at publish: each relinks the runtime too. -->
    <EventSourceSupport>false</EventSourceSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>false</MetricsSupport>
    <StackTraceSupport>false</StackTraceSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true' or '$(WasmBuildingForNestedPublish)' == 'true'">
    <!-- The runtime relinked to what the app uses, at publish only: it needs
         the wasm-tools workload, which the jobs that publish install and the
         build jobs do not (ADR 0200). InvariantTimezone and
         InvariantGlobalization are here for the same reason: both are on the
         runtime pack's list of properties that trigger a relink, so set on a
         plain build they relink wherever the workload is installed (the
         devcontainer, which has no Python for emscripten), and
         InvariantTimezone makes restore require the workload. The
         relink runs in a nested publish that clears _IsPublishing and sets
         WasmBuildingForNestedPublish, so the condition names both. -->
    <WasmBuildNative>true</WasmBuildNative>
    <WasmNativeStrip>true</WasmNativeStrip>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Protocol.Client/Varve.Protocol.Client.csproj" />
    <!-- The shared components, loaded with the first screen, and the explorer,
         loaded when its first route is visited (ADR 0252). -->
    <ProjectReference Include="../Varve.WebUi.Components/Varve.WebUi.Components.csproj" />
    <ProjectReference Include="../Varve.WebUi.Explorer/Varve.WebUi.Explorer.csproj" />
  </ItemGroup>

  <!-- The graph view's spike (#355): its script, from tests/, built in only
       when -p:VarveGraphSpike=true; its page is the explorer's, under the same
       switch. A shipped publish never sets it, so the bundle never holds them. -->
  <ItemGroup Condition="'$(VarveGraphSpike)' == 'true'">
    <Content Include="../../tests/Varve.WebUi.Spike/spike.js" Link="wwwroot/js/spike.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- docs/ui/ is the design source (ADR 0206): its two stylesheets and the
         core mark are linked into the bundle, one copy, never copied by a
         build step (point 2). -->
    <Content Include="../../docs/ui/tokens.css" Link="wwwroot/css/tokens.css" />
    <Content Include="../../docs/ui/bundle.css" Link="wwwroot/css/bundle.css" />
    <Content Include="../../docs/ui/assets/varve-core.svg" Link="wwwroot/img/varve-core.svg" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0003 permits InternalsVisibleTo toward *.Tests only. -->
    <InternalsVisibleTo Include="Varve.WebUi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blazor WebAssembly (ADR 0200), scoped to this project and its tests in
         the register. No DevServer: the server or a static host serves the
         bundle. No authentication package: sign-in is this host's own
         (ADR 0201). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lazy-loaded (ADR 0252; ADR 0205, amended 2026-11-19): the explorer
         and what only it uses, fetched when one of its routes is first
         visited. The first screen and this set are two rows of
         eng/browser-size.json, and the set here is the one that file names.
         Varve.Sparql.Results is the client's TSV reader, which only the
         Query page's streamed answers reach. -->
    <BlazorWebAssemblyLazyLoad Include="Varve.WebUi.Explorer.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Varve.Sparql.wasm" />
    <BlazorWebAssemblyLazyLoad Include="Varve.Sparql.Results.wasm" />
    <!-- The host names no type of the explorer (VARVE0006), so the trimmer
         would drop it whole: ExplorerRoots.xml keeps its pages and parts,
         which the router finds once it is loaded, and what they use of
         Varve.Sparql is trimmed from there. -->
    <TrimmerRootDescriptor Include="ExplorerRoots.xml" />
  </ItemGroup>

</Project>
