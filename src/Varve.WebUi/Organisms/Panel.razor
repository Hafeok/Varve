@* Panel (docs/ui/components/Panel): the container a resource renders in. A
   table goes in flush, so its rows run edge to edge. *@
<div class="vw-panel">@if (Title is not null)
{<div class="vw-panel__head"><h2 class="vw-panel__title">@Title</h2>@Head</div>}@if (Flush)
{@ChildContent}
else
{<div class="vw-panel__body">@ChildContent</div>}</div>

@code {
    /// <summary>The panel's section title, when it has a head.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Badges and actions in the head.</summary>
    [Parameter]
    public RenderFragment? Head { get; set; }

    /// <summary>The body.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>A table or list that runs edge to edge, with no body padding.</summary>
    [Parameter]
    public bool Flush { get; set; }
}
