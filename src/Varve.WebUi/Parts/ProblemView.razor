@* A problem from the client, as a ProblemPanel (docs/ui/components/ProblemPanel):
   its positions as stamps, every other member in code, the request id from
   the headers or the body, and the type linked to its page at the commit
   this build came from. The one place a Problem becomes parameters. *@
<ProblemPanel Status="(int)Problem.Status" Title="@(Problem.Title.Length > 0 ? Problem.Title : "The server answered with a problem")" Detail="@Problem.Detail" Type="@Problem.Type.Value" TypeHref="@(Problem.Type.Name is string name ? ProblemDocs.Page(name) : null)" RequestId="@((Facts?.RequestId ?? Problem.Instance)?.Value)" Actions="Actions">
    <Members>
        @foreach (KeyValuePair<string, System.Text.Json.JsonElement> member in Problem.Members)
        {
            @if (Positions.Contains(member.Key) && member.Value.ValueKind == System.Text.Json.JsonValueKind.Number && member.Value.TryGetInt64(out long position))
            {
                <KeyValueItem Label="@member.Key"><PositionStamp Label="@StampLabel(member.Key)" Value="position" Management="Management" /></KeyValueItem>
            }
            else
            {
                <KeyValueItem Label="@member.Key"><code>@member.Value.GetRawText()</code></KeyValueItem>
            }
        }
    </Members>
</ProblemPanel>

@code {
    // The members the catalogue (ADR 0119) gives as positions.
    private static readonly HashSet<string> Positions = new(StringComparer.Ordinal) { "position", "expectedPosition", "headPosition", "appliedPosition", "projectedPosition" };

    /// <summary>The problem.</summary>
    [Parameter, EditorRequired]
    public Problem Problem { get; set; } = null!;

    /// <summary>The response's facts, when the problem came from one.</summary>
    [Parameter]
    public ResponseFacts? Facts { get; set; }

    /// <summary>The positions are the system dataset's: the request was to /manage/.</summary>
    [Parameter]
    public bool Management { get; set; }

    /// <summary>The way on, such as reloading at the new position.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    private static string StampLabel(string member) => member switch
    {
        "expectedPosition" => "expected",
        "headPosition" => "head",
        "appliedPosition" => "applied",
        "projectedPosition" => "projected",
        _ => "position",
    };
}
