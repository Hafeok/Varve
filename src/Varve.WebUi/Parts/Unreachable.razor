@* The server did not answer (docs/ui/README.md, States): directly below the
   view head, above everything else, with the server's address and when it
   last answered; the last data stays below it. The wording is here, once,
   for every screen. *@
<Notice Title="The server did not answer" Warn="true"><code>@Server</code>: @Failure @(LastRead is { } last ? "Last read " + Times.Utc(last) + "." : "It has not answered yet.")</Notice>

@code {
    /// <summary>The server's address.</summary>
    [Parameter, EditorRequired]
    public string Server { get; set; } = "";

    /// <summary>What happened, as the client said it.</summary>
    [Parameter, EditorRequired]
    public string Failure { get; set; } = "";

    /// <summary>When it last answered, if it has.</summary>
    [Parameter]
    public DateTimeOffset? LastRead { get; set; }
}
