@* The stamps of one read (#167, A6): the data position the response
   describes, and the management position the instance answered at, each
   naming its log ("notes position 18417", "management position 412"). A
   position the server did not name is not shown, never invented. *@
@if (Facts.Position is { } position)
{<PositionStamp Label="@(Log is null ? "position" : Log + " position")" Value="position.Value" />}@if (Facts.ManagementPosition is { } management)
{<PositionStamp Label="management position" Value="management.Value" Management="true" />}

@code {
    /// <summary>The response's facts.</summary>
    [Parameter, EditorRequired]
    public ResponseFacts Facts { get; set; }

    /// <summary>The dataset whose log the data position is in.</summary>
    [Parameter]
    public string? Log { get; set; }
}
