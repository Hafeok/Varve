@inherits LayoutComponentBase
@using Varve.WebUi.SignIn
@implements IDisposable
@inject NavigationManager Navigation
@inject WebUiSettings Settings
@inject IServiceProvider Services
@inject ShellFacts Facts
@* The layout every screen renders in: the Shell template, given the server
   and the instance that answered, each plane's sign-in state with who is
   signed in, and the navigation with the current screen marked: Operate,
   then a dataset selector, defaulting to the dataset last viewed, with that
   dataset's own screens under it (review F01, F02, F22).

   With sign-in (ADR 0201), a tab with no token starts one on its first
   screen: silently first (prompt=none), so a reload with an issuer session
   is invisible. The callback and the signed-out screen start none. *@
<Shell Server="@Settings.Server.AbsoluteUri" Instance="@Facts.Instance" Planes="Planes" Navigation="Groups()" Datasets="Offered()" Dataset="@Selected()" DatasetNavigation="DatasetGroups()" OnDataset="Choose">
    <BarActions>@if (_session is { DataSignedIn: true })
    {<Button Small="true" OnClick="SignOutAsync">Sign out</Button>}</BarActions>
    <ChildContent><CascadingValue Value="Signed()">@Body</CascadingValue></ChildContent>
</Shell>

@code {
    private static readonly (string Group, string Text, string Href)[] Screens =
    [
        ("Operate", "Datasets", "datasets"),
        ("Operate", "Health", "health"),
        ("Operate", "Fleet", "fleet"),
    ];

    // The selected dataset's own screens, under the selector.
    private static readonly (string Group, string Text, string Path)[] DatasetScreens =
    [
        ("History", "Commits", "commits"),
        ("Declarations", "Grants", "grants"),
        ("Declarations", "Agents and roles", "agents"),
        ("Declarations", "Graph templates", "templates"),
        ("Declarations", "Shapes", "shapes"),
    ];

    // The callback and the signed-out screen start no sign-in.
    private static bool StartsSignIn(string route) => route is not ("signin" or "signedout");

    private SignInSession? _session;

    private IReadOnlyList<PlaneState> Planes =>
        Settings.Anonymous || _session is null
            ? [new PlaneState("Data plane", "anonymous", Anonymous: true, Absent: false), new PlaneState("Management", "anonymous", Anonymous: true, Absent: false)]
            : [Plane("Data plane", _session.DataSignedIn, _session.DataCaller), Plane("Management", _session.ManagementSignedIn, _session.ManagementCaller)];

    // Who is signed in, for the parts that say it.
    private SignedIn? Signed() => _session is null ? null : new SignedIn(_session.DataCaller, _session.ManagementCaller);

    private static PlaneState Plane(string name, bool signedIn, Varve.WebUi.SignIn.Caller? caller) =>
        new(name, signedIn ? "signed in" : "signed out", Anonymous: false, Absent: !signedIn, caller?.Agent, caller?.Roles);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += Changed;
        Facts.Changed += FactsChanged;
        _session = Settings.Anonymous ? null : Services.GetService(typeof(SignInSession)) as SignInSession;

        if (_session is not null)
        {
            _session.Changed += SessionChanged;
            string path = Navigation.ToBaseRelativePath(Navigation.Uri);

            if (!_session.DataSignedIn && StartsSignIn(path.Split('?', '#')[0]))
            {
                await _session.StartAsync("/" + path, silent: true, CancellationToken.None);
            }
        }

        ReadFacts();
    }

    // The shell's facts, read again on every navigation and sign-in: behind
    // one address, each read may reach another instance. Not before there is
    // a token to read them with.
    private void ReadFacts()
    {
        Remember();

        if (_session is null || _session.DataSignedIn)
        {
            _ = Facts.ReadAsync(CancellationToken.None);
        }
    }

    private void FactsChanged() => _ = InvokeAsync(StateHasChanged);

    // The dataset whose screen is open, from the address.
    private string? Open()
    {
        string[] segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Split('/');
        return segments.Length >= 2 && segments[0] == "datasets" && segments[1].Length > 0 ? Uri.UnescapeDataString(segments[1]) : null;
    }

    // The dataset viewed is the one the selector defaults to from now on.
    private void Remember()
    {
        if (Open() is { } open)
        {
            Facts.LastDataset = open;
        }
    }

    // The selector's dataset: the one open, else the one last viewed, else
    // the first there is.
    private string? Selected() => Open() ?? Facts.LastDataset ?? Facts.Datasets.FirstOrDefault();

    // The datasets offered, the selected one among them even when the list
    // could not be read.
    private IReadOnlyList<string> Offered() =>
        Selected() is { } selected && !Facts.Datasets.Contains(selected) ? [selected, .. Facts.Datasets] : Facts.Datasets;

    // Another dataset selected: on a dataset's screen, the same screen of the
    // new one; anywhere else, the rail's links follow it.
    private void Choose(string dataset)
    {
        Facts.LastDataset = dataset;
        string[] segments = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Split('/');

        if (segments.Length >= 2 && segments[0] == "datasets" && segments[1].Length > 0)
        {
            segments[1] = Uri.EscapeDataString(dataset);
            Navigation.NavigateTo(string.Join('/', segments));
        }
    }

    private Task SignOutAsync() => _session!.SignOutAsync(CancellationToken.None);

    private void SessionChanged() => _ = InvokeAsync(() =>
    {
        ReadFacts();
        StateHasChanged();
    });

    private IReadOnlyList<NavGroup> Groups()
    {
        string current = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        List<NavGroup> groups = [];

        foreach (IGrouping<string, (string Group, string Text, string Href)> group in Screens.GroupBy(screen => screen.Group))
        {
            groups.Add(new NavGroup(group.Key, [.. group.Select(screen => new NavEntry(screen.Text, screen.Href, Current(current, screen.Href) && !InDatasetScreen(current)))]));
        }

        return groups;
    }

    private IReadOnlyList<NavGroup> DatasetGroups()
    {
        if (Selected() is not { } selected)
        {
            return [];
        }

        string current = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        string dataset = "datasets/" + Uri.EscapeDataString(selected) + "/";
        return [.. DatasetScreens.GroupBy(screen => screen.Group).Select(group => new NavGroup(group.Key, [.. group.Select(screen => new NavEntry(screen.Text, dataset + screen.Path, Current(current, dataset + screen.Path)))]))];
    }

    // A screen is current on its own address and below it (a dataset under
    // Datasets), and the root is Datasets.
    private static bool Current(string route, string href) =>
        route == href || route.StartsWith(href + "/", StringComparison.Ordinal) || (route.Length == 0 && href == "datasets");

    // Within a dataset's own screen, that screen is current, not Datasets.
    private static bool InDatasetScreen(string route)
    {
        string[] segments = route.Split('/');
        return segments.Length >= 3 && segments[0] == "datasets";
    }

    private void Changed(object? sender, LocationChangedEventArgs e)
    {
        ReadFacts();
        StateHasChanged();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Navigation.LocationChanged -= Changed;
        Facts.Changed -= FactsChanged;

        if (_session is not null)
        {
            _session.Changed -= SessionChanged;
        }
    }
}
