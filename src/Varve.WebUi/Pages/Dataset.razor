@page "/datasets/{Name}"
@using Varve.Delta.Model
@inject VarveManagementClient Management
@inject VarveHealthClient Health
@inject DatasetClients Datasets
@inject WebUiSettings Settings
@inject TimeProvider Clock
@inject NavigationManager Navigation
@* A dataset (docs/ui/screens/dataset--*.html): its status, its projections,
   its recent commits and its declaration, each read at the position its
   panel says. Pinned with ?asof=p, it shows the dataset as of that commit,
   and hides what the server serves only live (A6). What no route serves
   (a follower's writer address and epoch, the dataset's writer epoch, the
   last advance) is not shown (#96). *@
<PageTitle>@Name · Varve</PageTitle>
<ViewHead Title="@Name" CrumbText="Datasets" CrumbHref="datasets">@if (_asOf is FeedPosition pinned)
{<PositionStamp Label="as of" Value="pinned.Value" />@if (_lifecycle is not null && _lifecycle.Facts.ManagementPosition is FeedPosition management)
{<PositionStamp Label="management" Value="management.Value" Management="true" />}}
else if (_status is not null)
{<ReadStamps Facts="_status.Facts" />}</ViewHead>

@if (_failure is not null)
{
    <Unreachable Server="@Settings.Server.AbsoluteUri" Failure="@_failure" LastRead="_lastRead" />
}

@if (_lifecycle?.Problem is Problem gone)
{
    <ProblemView Problem="gone" Facts="_lifecycle.Facts" Management="true" />
}
else if (_asOf is FeedPosition at)
{
    @if (_pinned?.Value is FeedRecord commit)
    {
        <AsOfBanner Position="at.Value" CommittedAt="@Times.Utc(commit.Timestamp.Value)" Head="(_status?.Value?.Head?.Value ?? at.Value)" OnReturn="ReturnToHead" />
        <Panel Title="Status" TitleId="status-title">
            <Head><StateBadge Tone="Tone.Past" Word="@("as of " + at.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))" /></Head>
            <ChildContent>
                <KeyValue>
                    <KeyValueItem Label="State"><StateWord Word="@_lifecycle?.Value?.State?.Value" /></KeyValueItem>
                    <KeyValueItem Label="As of"><PositionStamp Label="as of" Value="at.Value" /></KeyValueItem>
                    <KeyValueItem Label="Committed"><code>@Times.Utc(commit.Timestamp.Value)</code> <span class="vw-muted">@Times.Ago(commit.Timestamp.Value, Clock.GetUtcNow())</span></KeyValueItem>
                    <KeyValueItem Label="Agent"><code>@(commit.Agent is { } agent ? System.Text.Encoding.UTF8.GetString(agent.Lexical) : "none")</code></KeyValueItem>
                </KeyValue>
            </ChildContent>
        </Panel>
        <Panel Title="@("Commits up to " + at.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))" Flush="true">
            <Commits Records="@(_recent?.Value?.Commits ?? [])" Dataset="This" />
        </Panel>
    }
    else if (_pinned?.Problem is Problem notThere)
    {
        <ProblemView Problem="notThere" Facts="_pinned.Facts" />
    }
}
else
{
    @if (_lifecycle?.Value?.Role == InstanceRole.Follower)
    {
        <Notice Title="@("This instance follows " + Name)">Writes go to the writer. Reads here are served at this instance's position.</Notice>
    }

    @if (_status?.Problem is Problem unavailable)
    {
        <ProblemView Problem="unavailable" Facts="_status.Facts" Management="true" />
    }
    else if (_status?.Value is DatasetStatus status)
    {
        DatasetReadiness? ready = Readiness();
        bool follower = _lifecycle?.Value?.Role == InstanceRole.Follower;

        <Panel Title="Status" TitleId="status-title">
            <Head>@if (follower)
            {<StateWord Word="@InstanceRole.Follower.Value" />}</Head>
            <ChildContent>
                <KeyValue>
                    <KeyValueItem Label="State"><StateWord Word="@(_lifecycle?.Value?.State?.Value ?? status.State?.Value)" /></KeyValueItem>
                    <KeyValueItem Label="This instance"><StateWord Word="@_lifecycle?.Value?.Role?.Value" /></KeyValueItem>
                    @if (Entry()?.Storage is StorageKind storage)
                    {
                        <KeyValueItem Label="Storage"><code>@storage.Value</code></KeyValueItem>
                    }
                    @if (_placement is InstanceName placed)
                    {
                        <KeyValueItem Label="Placed on"><code>@placed.Value</code></KeyValueItem>
                    }
                    @if (status.Head is FeedPosition head)
                    {
                        <KeyValueItem Label="@(follower ? "Head here" : "Head")"><PositionStamp Label="head" Value="head.Value" /></KeyValueItem>
                    }
                    @if (follower && ready?.Lag is PositionLag lag)
                    {
                        <KeyValueItem Label="Lag"><code>@lag</code>@if (ready.State is ReadinessState state && state != ReadinessState.Ready)
                        {<text> </text><StateWord Word="@state.Value" />}</KeyValueItem>
                    }
                    @if (LastCommit() is FeedRecord last)
                    {
                        <KeyValueItem Label="Last commit"><code>@Times.Utc(last.Timestamp.Value)</code> <span class="vw-muted">@Times.Ago(last.Timestamp.Value, Clock.GetUtcNow())</span></KeyValueItem>
                    }
                    <KeyValueItem Label="Last checkpoint">@if (status.Checkpoints.Count > 0)
                    {<PositionStamp Label="at" Value="status.Checkpoints.Max(checkpoint => checkpoint.Value)" />}
                    else
                    {<text>none</text>}</KeyValueItem>
                </KeyValue>
            </ChildContent>
        </Panel>

        <Panel Title="Projections" TitleId="projections-title" Flush="true">
            <ResourceTable ColumnCount="4" LabelledBy="projections-title">
                <Columns>
                    <th scope="col">Projection</th><th scope="col">State</th><th scope="col" class="vw-num">Position</th><th scope="col" class="vw-num">Lag</th>
                </Columns>
                <Rows>
                    @if (status.Projection is ProjectionStatus projection)
                    {
                        <tr><td class="vw-table__name">Default quads<span class="vw-table__sub">SPO, POS, OSP and graph variants</span></td><td><StateWord Word="@ProjectionWord(projection.Failed, projection.Lag)" /></td><td class="vw-num">@(projection.Position?.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "—")</td><td class="vw-num">@(projection.Lag?.ToString() ?? "—")</td></tr>
                    }
                    @foreach (KeyValuePair<string, PositionLag> binding in ready?.Validation ?? new Dictionary<string, PositionLag>())
                    {
                        <tr><td class="vw-table__name">Validation: @binding.Key<span class="vw-table__sub">shapes binding</span></td><td><StateWord Word="@ProjectionWord(false, binding.Value)" /></td><td class="vw-num">—</td><td class="vw-num">@binding.Value</td></tr>
                    }
                </Rows>
            </ResourceTable>
        </Panel>

        <Panel Title="Recent commits" TitleId="recent-commits-title" Flush="true">
            <Head><Button Small="true" OnClick="AllCommits">All commits</Button></Head>
            <ChildContent>
                @if (_recent?.Problem is Problem notRead)
                {
                    <ProblemView Problem="notRead" Facts="_recent.Facts" />
                }
                else
                {
                    <Commits Records="@(_recent?.Value?.Commits ?? [])" Dataset="This" />
                }
            </ChildContent>
        </Panel>
    }

    @if (_declaration?.Value is Declaration declaration)
    {
        <SourceBlock Graph="@("varve:manage/dataset/" + Name)" Position="_declaration.Facts.ManagementPosition?.Value" Source="@System.Text.Encoding.UTF8.GetString(declaration.Content.Span)" />
    }
}

@code {
    private VarveResult<DatasetLifecycle>? _lifecycle;
    private VarveResult<DatasetStatus>? _status;
    private VarveResult<Declaration>? _declaration;
    private VarveResult<CommitRange>? _recent;
    private VarveResult<FeedRecord>? _pinned;
    private IReadOnlyList<DatasetEntry> _entries = [];
    private IReadOnlyList<DatasetReadiness> _readiness = [];
    private InstanceName? _placement;
    private FeedPosition? _asOf;
    private DateTimeOffset? _lastRead;
    private string? _failure;

    /// <summary>The dataset's name, from the address.</summary>
    [Parameter]
    public string Name { get; set; } = "";

    /// <summary>The position the view is pinned at, from <c>?asof=</c>.</summary>
    [SupplyParameterFromQuery(Name = "asof")]
    public long? AsOf { get; set; }

    private DatasetName This => new(Name);

    /// <inheritdoc />
    protected override Task OnParametersSetAsync()
    {
        _asOf = AsOf is long at and > 0 ? new FeedPosition(at) : null;
        return ReadAsync();
    }

    private async Task ReadAsync()
    {
        try
        {
            SparqlHttpClient data = Datasets.For(This);
            Task<VarveResult<DatasetLifecycle>> lifecycle = Management.LifecycleAsync(This, CancellationToken.None);
            Task<VarveResult<DatasetStatus>> status = Management.StatusAsync(This, CancellationToken.None);
            Task<VarveResult<Declaration>> declaration = Management.DeclarationAsync(This, CancellationToken.None);
            Task<VarveResult<DatasetList>> list = Management.DatasetsAsync(CancellationToken.None);
            Task<VarveResult<PlacementList>> placements = Management.PlacementsAsync(CancellationToken.None);
            Task<VarveResult<Readiness>> readiness = Health.ReadyAsync(CancellationToken.None);
            _lifecycle = await lifecycle;
            _status = await status;
            _declaration = await declaration;
            _entries = (await list).Value?.Datasets ?? _entries;
            _placement = (await placements).Value?.Placements.TryGetValue(This, out InstanceName placed) == true ? placed : null;
            _readiness = (await readiness).Value?.Datasets ?? _readiness;

            FeedPosition? upTo = _asOf ?? _status.Value?.Head;

            if (upTo is FeedPosition to && to.Value > 0)
            {
                _recent = await data.ReadCommitsAsync(new FeedPosition(Math.Max(0, to.Value - 3)), to, CancellationToken.None);
            }

            _pinned = _asOf is FeedPosition at ? await data.ReadCommitAsync(at, CancellationToken.None) : null;
            _lastRead = Clock.GetUtcNow();
            _failure = null;
        }
        catch (HttpRequestException e)
        {
            _failure = e.Message;
        }
    }

    private DatasetEntry? Entry() => _entries.FirstOrDefault(entry => entry.Name == This);

    private DatasetReadiness? Readiness() => _readiness.FirstOrDefault(entry => entry.Name == This);

    private FeedRecord? LastCommit() => _recent?.Value?.Commits.LastOrDefault(record => record.Kind == FeedRecordKind.Commit);

    // A projection's word: failed, behind when it lags, current when it does not.
    private static string ProjectionWord(bool failed, PositionLag? lag) =>
        failed ? "failed" : lag is { Value: > 0 } ? "behind" : "current";

    private void AllCommits() => Navigation.NavigateTo("datasets/" + Uri.EscapeDataString(Name) + "/commits");

    private void ReturnToHead() => Navigation.NavigateTo("datasets/" + Uri.EscapeDataString(Name));
}
