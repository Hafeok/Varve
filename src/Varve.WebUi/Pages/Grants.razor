@page "/datasets/{Name}/grants"
@inject VarveManagementClient Management
@inject WebUiSettings Settings
@inject TimeProvider Clock
@inject NavigationManager Navigation
@* A dataset's grants (docs/ui/screens/declarations--grants.html), read-only.
   Pinned with ?asof=p, they are read as of management position p: the
   management log, a different axis from the dataset's (A6). *@
<PageTitle>Grants of @Name · Varve</PageTitle>
<ViewHead Title="Grants" CrumbText="@Name" CrumbHref="@("datasets/" + Uri.EscapeDataString(Name))">@if (_asOf is FeedPosition pinned)
{<PositionStamp Label="as of" Value="pinned.Value" />}@if (_grants?.Facts.ManagementPosition is FeedPosition management)
{<PositionStamp Label="management" Value="management.Value" Management="true" />}</ViewHead>

@if (_failure is not null)
{
    <Unreachable Server="@Settings.Server.AbsoluteUri" Failure="@_failure" LastRead="_lastRead" />
}

@if (_asOf is FeedPosition at)
{
    <AsOfBanner Position="at.Value" Head="(_head?.Value ?? at.Value)" OnReturn="ReturnToHead" />
}
else
{
    <ReadOnlyDeclarations />
}

@if (_grants?.Problem is Problem problem)
{
    <ProblemView Problem="problem" Facts="_grants.Facts" Management="true" />
}
else if (_grants?.Value is GrantList grants)
{
    <Panel Title="@(_asOf is null ? "Who may read and write which graphs" : "Who could read and write, then")" TitleId="grants-title" Flush="true">
        <ResourceTable ColumnCount="4" LabelledBy="grants-title" Empty="grants.Grants.Count == 0">
            <Columns>
                <th scope="col">Grantee</th><th scope="col">Permission</th><th scope="col">Scope</th><th scope="col">Declared in</th>
            </Columns>
            <EmptyContent>No grant is declared for this dataset. Only operators reach it.</EmptyContent>
            <Rows><GrantRows Grants="grants.Grants" Dataset="new DatasetName(Name)" /></Rows>
        </ResourceTable>
    </Panel>
}

@code {
    private VarveResult<GrantList>? _grants;
    private FeedPosition? _head;
    private FeedPosition? _asOf;
    private DateTimeOffset? _lastRead;
    private string? _failure;

    /// <summary>The dataset's name, from the address.</summary>
    [Parameter]
    public string Name { get; set; } = "";

    /// <summary>The management position the grants are pinned at, from <c>?asof=</c>.</summary>
    [SupplyParameterFromQuery(Name = "asof")]
    public long? AsOf { get; set; }

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        _asOf = AsOf is long at and >= 0 ? new FeedPosition(at) : null;

        try
        {
            Task<VarveResult<GrantList>> grants = Management.GrantsAsync(new DatasetName(Name), _asOf, CancellationToken.None);
            Task<VarveResult<SystemPlane>> system = Management.SystemAsync(CancellationToken.None);
            _grants = await grants;
            _head = (await system).Value?.Tail;
            _lastRead = Clock.GetUtcNow();
            _failure = null;
        }
        catch (HttpRequestException e)
        {
            _failure = e.Message;
        }
    }

    private void ReturnToHead() => Navigation.NavigateTo("datasets/" + Uri.EscapeDataString(Name) + "/grants");
}
