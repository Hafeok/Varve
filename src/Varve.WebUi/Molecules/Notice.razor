@* Notice (docs/ui/components/Notice): a sentence the operator needs before
   acting, inline in the flow. Generic: the page passes the words in, the
   drift note's included. Never an error from the API: those are problem
   panels. *@
<div class="@(Warn ? "vw-notice vw-notice--warn" : "vw-notice")"><p class="vw-notice__title">@Title</p><p class="vw-notice__body">@ChildContent</p></div>

@code {
    /// <summary>A one-line title.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>A short body.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The operator should think before going on.</summary>
    [Parameter]
    public bool Warn { get; set; }
}
