<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Layer 2: JSON-LD 1.1 over the BCL's Utf8JsonReader and Utf8JsonWriter (ADR 0123).
         docs/spec/json-ld.md. -->
    <ArchLayer>2</ArchLayer>
    <IsPackable>true</IsPackable>
    <Description>JSON-LD 1.1: expansion, toRdf and fromRdf over System.Text.Json's Utf8JsonReader and Utf8JsonWriter, with RDF 1.2's base directions and rdf:JSON literals in canonical form.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Rdf/Varve.Rdf.csproj" />
    <ProjectReference Include="../Varve.Iri/Varve.Iri.csproj" />
    <ProjectReference Include="../Varve.Xsd/Varve.Xsd.csproj" />
  </ItemGroup>

</Project>
