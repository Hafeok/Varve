<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Layer 5: the object-store contract over Azure Blob Storage's REST API.
         It references Varve.Store only, and no SDK (ADR 0134). -->
    <ArchLayer>5</ArchLayer>
    <IsPackable>true</IsPackable>

    <!-- No ambient clock and no ambient randomness: a token's expiry and a
         retry's wait are read from the caller's clock (ADR 0011). -->
    <VarveDeterministic>true</VarveDeterministic>

    <!-- System.Uri for the container's address only, a transport address and
         never an IRI (ADR 0134, AdaptersSpeakHttp; ADR 0004, amended). -->
    <VarveSpeaksHttp>true</VarveSpeaksHttp>

    <!-- Its contracts name Varve.Store's: it implements them and is nothing
         without them (ADR 0134, BackendContractsNameTheStore). -->
    <ArchContractTypeAssemblies>$(ArchContractTypeAssemblies);Varve.Store</ArchContractTypeAssemblies>

    <Description>Azure Blob Storage for a Varve store's object-storage backend: the five object-store operations over the REST API, authenticated by the workload's own identity.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Store/Varve.Store.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Varve.Store.Tests" />
  </ItemGroup>

</Project>
