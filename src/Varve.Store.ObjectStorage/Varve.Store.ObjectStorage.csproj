<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Layer 5: the storage contract over any object store with conditional
         writes. It references Varve.Store only, and no provider (ADR 0134). -->
    <ArchLayer>5</ArchLayer>
    <IsPackable>true</IsPackable>

    <!-- No ambient clock and no ambient randomness: the writer record's
         timestamps come from the caller's clock (ADR 0011). -->
    <VarveDeterministic>true</VarveDeterministic>

    <!-- Its contracts name Varve.Store's: it implements them and is nothing
         without them (ADR 0134, BackendContractsNameTheStore). -->
    <ArchContractTypeAssemblies>$(ArchContractTypeAssemblies);Varve.Store</ArchContractTypeAssemblies>

    <Description>Storage for a Varve store in any object store with conditional writes: the log as write-once chunk objects, one writer by an epoch fenced in the log itself, and a local cache.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Store/Varve.Store.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Varve.Store.Tests" />
  </ItemGroup>

</Project>
