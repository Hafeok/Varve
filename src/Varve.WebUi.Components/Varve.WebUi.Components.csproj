<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- The Web UI's shared components (ADR 0252): the design system's levels,
         the parts both page sets use and Pages.Services, loaded with the first
         screen. A private assembly of the host Varve.WebUi, at its layer and
         part of its composition root: nothing but the host and the explorer
         references it, it is never packed, and VARVE0005 admits a layer-6
         library only when it names its host (ADR 0060, amended 2026-11-19). -->
    <ArchLayer>6</ArchLayer>
    <ArchCompositionRoot>true</ArchCompositionRoot>
    <VarveHostPartOf>Varve.WebUi</VarveHostPartOf>
    <IsPackable>false</IsPackable>

    <!-- Trimmed with the bundle: the host's partial trim mode trims every
         assembly marked trimmable (ADR 0200). -->
    <IsTrimmable>true</IsTrimmable>

    <!-- Transport addresses are System.Uri, as in the client (ADR 0004, amended 2026-10-08). -->
    <VarveSpeaksHttp>true</VarveSpeaksHttp>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Protocol.Client/Varve.Protocol.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Blazor (ADR 0200), scoped to the Web UI's projects in the register. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0003 permits InternalsVisibleTo toward *.Tests only. -->
    <InternalsVisibleTo Include="Varve.WebUi.Tests" />
  </ItemGroup>

  <!-- The commit this build came from, as a constant: a problem's page is
       linked at it (ProblemDocs). Written from SourceLink's SourceRevisionId,
       because reading it back from an assembly attribute at run time would be
       reflection, which shipped code never uses. -->
  <Target Name="WriteBuildRevision" AfterTargets="InitializeSourceControlInformation" BeforeTargets="CoreCompile;CoreGenerateAssemblyInfo" DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_BuildRevisionFile>$(IntermediateOutputPath)BuildRevision.g.cs</_BuildRevisionFile>
      <_BuildRevisionCommit Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('$(SourceRevisionId)', '^[0-9a-f]{40}$'))">$(SourceRevisionId)</_BuildRevisionCommit>
    </PropertyGroup>
    <WriteLinesToFile File="$(_BuildRevisionFile)" Overwrite="true" WriteOnlyWhenDifferent="true" Lines="// Generated by Varve.WebUi.Components.csproj.;namespace Varve.WebUi.Components%3B;internal static class BuildRevision { internal const string Commit = &quot;$(_BuildRevisionCommit)&quot;%3B }" />
    <ItemGroup>
      <Compile Include="$(_BuildRevisionFile)" />
      <FileWrites Include="$(_BuildRevisionFile)" />
    </ItemGroup>
  </Target>

</Project>
