<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Layer 6: the executable, the composition root (ADRs 0060, 0091,
         0101). Configuration, hosting, authentication, and the wiring of
         datasets, clocks and the update executor. -->
    <OutputType>Exe</OutputType>
    <ArchLayer>6</ArchLayer>
    <ArchCompositionRoot>true</ArchCompositionRoot>
    <RootNamespace>Varve.Server</RootNamespace>
    <VarveSpeaksHttp>true</VarveSpeaksHttp>

    <!-- ADR 0105: the one executable is the server and the `varve` command
         line, shipped as a .NET tool and as a native single file. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>varve</ToolCommandName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>Varve: the server and the varve command line. An event-sourced RDF store with SPARQL 1.1 Query, Update, Graph Store Protocol and a change feed over HTTP.</Description>

    <!-- Native AOT is a gate (ADR 0101): minimal APIs only, no MVC, JSON
         without reflection, configuration bound by the source generator. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>

    <!-- ADR 0110: the shipped runtime configuration. The Web SDK defaults to
         server GC, which keeps committed memory proportional to what every
         core allocated; the server's live heap is small and allocates in
         bursts, which the workstation collector with concurrent collections
         fits, and ConserveMemory compacts the large object heap that 6c found
         fragmenting. No heap hard limit of our own: in a container the runtime
         bounds the heap to the cgroup limit. The tool's runtimeconfig and the
         AOT binary carry the same three settings. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADR 0110. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Protocol/Varve.Protocol.csproj" />
    <ProjectReference Include="../Varve.Protocol.Client/Varve.Protocol.Client.csproj" />
    <ProjectReference Include="../Varve.Sparql.Store/Varve.Sparql.Store.csproj" />
    <ProjectReference Include="../Varve.Store/Varve.Store.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server's tests run its composition root in process (ADR 0100). -->
    <InternalsVisibleTo Include="Varve.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR 0099: the server's alone. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- ADR 0105: the command line and the Windows credential store. -->
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <!-- ADR 0112: the exporter, the server's alone. -->
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
  </ItemGroup>

</Project>
