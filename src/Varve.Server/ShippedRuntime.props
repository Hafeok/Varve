<Project>

  <!--
    ADR 0110: the shipped runtime configuration, in one place. Varve.Server
    imports it, so the tool's runtimeconfig, the AOT binary and the container
    image carry it; Varve.Benchmarks imports it, so the soak runs under exactly
    what the image ships, and the soak judge refuses a run that did not (ADR
    0215).

    The Web SDK defaults to server GC, which keeps committed memory
    proportional to what every core allocated; the server's live heap is small
    and allocates in bursts, which the workstation collector with concurrent
    collections fits, and ConserveMemory compacts the large object heap that 6c
    found fragmenting. No heap hard limit of our own: in a container the
    runtime bounds the heap to the cgroup limit.
  -->

  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

</Project>
