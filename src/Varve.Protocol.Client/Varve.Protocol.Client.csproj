<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Layer 5: the HTTP client of the SPARQL Protocol, the Graph Store
         Protocol, the change feed and the admin API, and the SERVICE handler
         and the document fetch LOAD needs, over the BCL's HttpClient (ADRs
         0103, 0104). It references neither Varve.Protocol nor
         Varve.Sparql.Store: both are layer 5 (ADR 0060). Nor Varve.Store: a
         consumer of the API or the feed ships no store; the feed's format is
         Varve.Delta's (ADR 0128). -->
    <ArchLayer>5</ArchLayer>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Nothing here reads an ambient clock: a timeout is a cancellation the
         caller's token and the limits produce (ADR 0056). -->
    <VarveDeterministic>true</VarveDeterministic>

    <!-- System.Uri for transport addresses only: the endpoint a request goes
         to, built after the endpoint policy has checked the IRI's bytes. Every
         IRI is still Varve.Iri. ADR 0004, amended 2026-10-08; ADR 0103. -->
    <VarveSpeaksHttp>true</VarveSpeaksHttp>

    <!-- Its follower's checkpoint names a FeedPosition: the delta format's
         position, which is what a follower checkpoints (ADR 0129). Widened
         here and nowhere else, as ADR 0064 requires. -->
    <ArchContractTypeAssemblies>$(ArchContractTypeAssemblies);Varve.Delta</ArchContractTypeAssemblies>

    <Description>The HTTP client for a Varve server: SPARQL Protocol queries and updates, the Graph Store Protocol, the change feed and the admin API, with the SERVICE handler and the document fetch that federate a query and a LOAD under an endpoint policy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Varve.Delta/Varve.Delta.csproj" />
    <ProjectReference Include="../Varve.Sparql.Evaluation/Varve.Sparql.Evaluation.csproj" />
    <ProjectReference Include="../Varve.Sparql.Results/Varve.Sparql.Results.csproj" />
    <ProjectReference Include="../Varve.Sparql/Varve.Sparql.csproj" />
    <ProjectReference Include="../Varve.Turtle/Varve.Turtle.csproj" />
    <!-- A setup's baseline is read before it is sent, to refuse a blank node
         (ADR 0130), in any syntax a Graph Store write takes. -->
    <ProjectReference Include="../Varve.RdfXml/Varve.RdfXml.csproj" />
    <ProjectReference Include="../Varve.JsonLd/Varve.JsonLd.csproj" />
    <ProjectReference Include="../Varve.Rdf/Varve.Rdf.csproj" />
    <ProjectReference Include="../Varve.Iri/Varve.Iri.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddVarve and the hosted service that applies a setup at start (ADR 0131). -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

</Project>
