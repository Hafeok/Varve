<Project>

  <!--
    Imported after every project body, so it sees the project's own settings.
  -->

  <!--
    ADR 0003 — surface the declared layer as assembly metadata.

    A referencing compilation learns the layer of a referenced assembly by
    reading this attribute off the referenced assembly symbol. The BCL's
    AssemblyMetadataAttribute is used deliberately: a Varve-defined attribute
    type would have to live in a package below layer 0, which is the same as
    saying it would break the rule it exists to express.

    'none' emits nothing. A test, benchmark or analyzer assembly has no layer,
    and VARVE0002 treats absent metadata on those as correct rather than as a
    missing declaration.

    A malformed value IS emitted, on purpose: the declaring project's own
    VARVE0002 reports it from the build property, and emitting it keeps the
    assembly honest about what it declared rather than silently dropping it.
  -->
  <ItemGroup Condition="'$(VarveLayer)' != '' and '$(VarveLayer)' != 'none'">
    <AssemblyMetadata Include="Varve.Layer" Value="$(VarveLayer)" />
  </ItemGroup>

  <!--
    ADR 0004 — off-the-shelf enforcement, for packable projects only.

    Nothing is packable at milestone 1. These are wired and inert until
    Varve.Iri exists at milestone 3; see docs/roadmap.md. Configured is not the
    same as proven, and the roadmap says so.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <!-- Switches on the trimming, AOT and single-file analyzers. The
         IL-prefixed diagnostics they raise are errors in .editorconfig and
         never enter NoWarn: constraint 2 is not a preference. -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
  </PropertyGroup>

  <!--
    ADR 0029 — package metadata.

    Here rather than in Directory.Build.props because IsPackable is set in the
    project body, which props is imported before and cannot see.

    Nothing here names a repository host. RepositoryUrl comes from the git
    remote at pack time through SourceLink, so moving the repository to another
    organisation changes no file in this tree. PackageProjectUrl is the one
    value that has to be written down, and it is the only line to revisit on a
    move — along with the trusted-publishing policy on nuget.org, which is not
    in this repository at all.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Authors>decision-driven-design</Authors>
    <Company>decision-driven-design</Company>
    <Copyright>Copyright (c) 2026 Emil Okkels Klein</Copyright>

    <!-- An SPDX expression, never a licenseUrl: licenseUrl is deprecated and
         points at a page that can change under the package. ADR 0031. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>

    <PackageProjectUrl>https://github.com/Hafeok/Varve</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- An embedded icon, never an iconUrl: same reason. -->
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <PackageTags>rdf;sparql;graph-database;event-sourcing;semantic-web;linked-data</PackageTags>

    <!-- A deterministic, restorable symbol package. Sources are embedded, so a
         consumer can step into Varve without a symbol server. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)eng/icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="" />

    <!-- The licence text and the notice travel with the package. The SPDX
         expression above tells nuget.org which licence it is; these two are for
         the person who has the .nupkg and not the web page. MPL-2.0 §3.1
         requires the source form to be available under the licence's terms, and
         a copy of the terms beside the embedded sources is the least surprising
         way to satisfy a reader looking for them. ADR 0031. -->
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="" Visible="false" />

    <!-- Versioning from the git tag (ADR 0029). PrivateAssets keeps it out of
         the consumer's dependency graph; it exists at build time only. -->
    <PackageReference Include="MinVer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />

    <!-- The public API baseline lives beside the project. Every new public
         member is then a line in a reviewable diff. -->
    <AdditionalFiles Include="PublicAPI.Shipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt')" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" Condition="Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')" />

    <!-- One banned-symbol list for the whole repository. ADR 0004 records that
         its System.Uri entry must be narrowed before layer 5 exists. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/BannedSymbols.txt" />

    <!-- ADR 0026. One source file rather than a package: principle 3 forbids a
         grab-bag and the layering rule forbids anything below layer 0. The
         attribute is internal, so each assembly gets its own harmless copy and
         none of them enters a public API baseline. -->
    <Compile Include="$(MSBuildThisFileDirectory)eng/HotPathAttribute.cs"
             Link="Properties/HotPathAttribute.cs" />
  </ItemGroup>

  <!--
    ADR 0011 — no ambient clock and no ambient randomness, for the projects whose
    bytes §10's determinism property compares. A project opts in with
    VarveDeterministic; Varve.Store does. BannedApiAnalyzers reads every
    additional file named BannedSymbols.*.txt, so this list adds to the
    repository-wide one rather than replacing it. The fixture in
    tests/fixtures/banned-api/ opts in the same way, which is what proves the
    wiring rather than the list.
  -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' and '$(VarveDeterministic)' == 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/BannedSymbols.Deterministic.txt" />
  </ItemGroup>

</Project>
