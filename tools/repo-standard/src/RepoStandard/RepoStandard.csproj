<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>RepoStandard</AssemblyName>
    <RootNamespace>RepoStandard</RootNamespace>
    <Version>0.1.0</Version>

    <!-- A dotnet tool. Packing is how it is built as one; nothing packs it for
         publication from this repository (ADR 0039). -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>repo-standard</ToolCommandName>
    <PackageId>RepoStandard</PackageId>
    <Description>Applies a declared set of GitHub repository settings: plan, apply, check for drift, export.</Description>

    <!-- The Native AOT single-file binary is the other build, and the one the
         Action downloads. The analyzers are on for every build so an AOT
         problem is a compile error before it is an ILC one. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- ADR 0224: every RID it is published for is in its lockfile. Only while
         restoring: the RIDs are the lockfile's, not the build's, and since
         .NET 10 a tool project with RuntimeIdentifiers packs as RID-specific
         packages behind a pointer package that carries no assembly. A
         publish for a RID restores first, without it, then publishes with
         no restore of its own. -->
    <RuntimeIdentifiers Condition="'$(MSBuildIsRestoring)' == 'true'">$(VarveNativeRuntimeIdentifiers)</RuntimeIdentifiers>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>

    <!-- Reflection-based System.Text.Json is off: every serialisation goes
         through the source-generated context or JsonNode. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Always, so that the restore, which runs without a runtime identifier
       (ADR 0224: one lockfile for every runner), resolves the ILCompiler the
       Native AOT publish needs. PublishAot changes only `dotnet publish`: a
       plain build and `dotnet pack` stay framework-dependent. Published with
       a restore first, then a publish for the RID that does not restore. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RepoStandard.Tests" />
  </ItemGroup>

</Project>
