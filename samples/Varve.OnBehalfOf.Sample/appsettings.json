{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "{tenant}",
    "ClientId": "{calling-app-id}",
    "Audience": "api://varve-caller",
    "ClientCredentials": [
      {
        "SourceType": "SignedAssertionFilePath",
        "SignedAssertionFileDiskPath": "{a federated token: GitHub Actions' OIDC token, or a workload identity's}"
      }
    ]
  },
  "Varve": {
    "Dataset": "https://varve.example/datasets/orders/",
    "Scope": "api://varve/access_as_user"
  }
}
