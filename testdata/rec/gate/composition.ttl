# The REC gate's additions to REC 4.1.0's shapes graph (ADR 0176), loaded
# beside rec.ttl, Brick+patches.ttl and recimports.ttl as one RDF merge.
# Neither is a patch to REC: each states what its composition leaves out.

@prefix brick: <https://brickschema.org/schema/Brick#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ref: <https://brickschema.org/schema/Brick/ref#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# 1. OWL's own triple: the 1,445 Brick shapes typed owl:Class and
# sh:NodeShape are implicit class targets (SHACL 1.2 Core §3.1.3.3) only
# when owl:Class is a subclass of rdfs:Class. Read under
# varve:subClassOfInShapesGraph (§6.4).
owl:Class rdfs:subClassOf rdfs:Class .

# 2. The prefix declarations Brick's three SPARQL constraints name by
# sh:prefixes and no file declares (SHACL 1.2 SPARQL §2; §5.2.1 of the 2017
# Recommendation). Each node declares its own prefix. brick: also declares
# owl:, which bsh:DeprecationRuleForInstances uses without naming it. ref:
# also declares brick:, which bsh:TimeseriesReferenceOnPointsConstraint uses
# without naming it. No constraint names two nodes that declare the same
# prefix.
rdf: sh:declare [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .
rdfs: sh:declare [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .
brick: sh:declare
    [ sh:prefix "brick" ; sh:namespace "https://brickschema.org/schema/Brick#"^^xsd:anyURI ] ,
    [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] .
ref: sh:declare
    [ sh:prefix "ref" ; sh:namespace "https://brickschema.org/schema/Brick/ref#"^^xsd:anyURI ] ,
    [ sh:prefix "brick" ; sh:namespace "https://brickschema.org/schema/Brick#"^^xsd:anyURI ] .
