    "Id": "q",
    "Label": "Query",
    "Text": "PREFIX dct: <http://purl.org/dc/terms/>\nPREFIX notes: <https://notes.example/notes/>\n# Titles of the notes created this week\nSELECT DISTINCT ?note ?title WHERE {\n  GRAPH ?g { ?note a notes:Note ; dct:title ?title ; dct:created ?d . }\n  FILTER (?d >= \"2026-10-20\"^^xsd:date && LANG(?title) = \"en\")\n  OPTIONAL { ?note dct:creator _:who }\n}\nORDER BY DESC(?d) LIMIT 500",
